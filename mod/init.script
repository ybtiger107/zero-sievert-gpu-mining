-- Callback scope contract (Mod API 3): event and object callbacks cannot rely
-- on variables defined outside themselves. Persistent state therefore lives in
-- FileData under literal keys, constants are literals inside each function,
-- and shared helpers are exposed with namespaced ScriptExpose names and
-- fetched with ScriptGet inside the function that uses them. Helpers are
-- exposed here before any callback can run.

-- Content definitions
ScriptExecute("scripts/item.script");
ScriptExecute("scripts/rig.script");
ScriptExecute("scripts/chest.script");

-- Initialize canonical state once from the published legacy keys. Canonical
-- state is validated on later loads without reading legacy state again.
ScriptExpose("GpuMining3485717804InitializeState", func() {
    let state_version = FileDataRead("gpu_mining_3485717804_state_version");

    if (state_version == undefined) {
        let progress_steps = 0;
        let max_rig_level = 0;
        let rig_seen = 0;
        let pending_btc = 0;
        let btc_price = 100000;

        let legacy_progress_steps = FileDataRead("Time BTC");
        if (legacy_progress_steps != undefined) {
            progress_steps = Clamp(Round(legacy_progress_steps), 0, 162000);
        }

        let legacy_rig_level = FileDataRead("Rig level");
        if (legacy_rig_level != undefined) {
            max_rig_level = Clamp(Round(legacy_rig_level), 0, 10);
        }

        -- The old implementation wrote this as Boolean even though Boolean is
        -- not a documented FileDataWrite value type. Only accept known values.
        let legacy_rig_seen = FileDataRead("Rig made");
        if (legacy_rig_seen == true or legacy_rig_seen == 1) {
            rig_seen = 1;
        }
        if (max_rig_level > 0) {
            rig_seen = 1;
        }

        let legacy_pending_btc = FileDataRead("Rig has");
        if (legacy_pending_btc != undefined) {
            pending_btc = Clamp(Round(legacy_pending_btc), 0, 10);
        }

        let legacy_btc_price = FileDataRead("btc price");
        if (legacy_btc_price != undefined) {
            if (legacy_btc_price >= 100000 and legacy_btc_price <= 400000) {
                btc_price = Round(legacy_btc_price);
            }
        }

        FileDataWrite("gpu_mining_3485717804_progress_steps", progress_steps);
        FileDataWrite("gpu_mining_3485717804_rig_seen", rig_seen);
        FileDataWrite("gpu_mining_3485717804_max_rig_level", max_rig_level);
        FileDataWrite("gpu_mining_3485717804_pending_btc", pending_btc);
        FileDataWrite("gpu_mining_3485717804_btc_price", btc_price);
        FileDataWrite("gpu_mining_3485717804_state_version", 1);
    } else {
        let progress_steps = FileDataRead("gpu_mining_3485717804_progress_steps");
        if (progress_steps == undefined) {
            progress_steps = 0;
        }
        progress_steps = Clamp(Round(progress_steps), 0, 162000);
        FileDataWrite("gpu_mining_3485717804_progress_steps", progress_steps);

        let saved_rig_seen = FileDataRead("gpu_mining_3485717804_rig_seen");
        let rig_seen = 0;
        if (saved_rig_seen == 1 or saved_rig_seen == true) {
            rig_seen = 1;
        }

        let max_rig_level = FileDataRead("gpu_mining_3485717804_max_rig_level");
        if (max_rig_level == undefined) {
            max_rig_level = 0;
        }
        max_rig_level = Clamp(Round(max_rig_level), 0, 10);
        if (max_rig_level > 0) {
            rig_seen = 1;
        }
        FileDataWrite("gpu_mining_3485717804_rig_seen", rig_seen);
        FileDataWrite("gpu_mining_3485717804_max_rig_level", max_rig_level);

        let pending_btc = FileDataRead("gpu_mining_3485717804_pending_btc");
        if (pending_btc == undefined) {
            pending_btc = 0;
        }
        pending_btc = Clamp(Round(pending_btc), 0, 10);
        FileDataWrite("gpu_mining_3485717804_pending_btc", pending_btc);

        let btc_price = FileDataRead("gpu_mining_3485717804_btc_price");
        if (btc_price == undefined) {
            btc_price = 100000;
        }
        if (btc_price < 100000 or btc_price > 400000) {
            btc_price = 100000;
        }
        btc_price = Round(btc_price);
        FileDataWrite("gpu_mining_3485717804_btc_price", btc_price);
    }
});

-- Detect the highest physical Rig currently visible to the documented
-- inventory API, then update the historical maximum only upward.
ScriptExpose("GpuMining3485717804SyncRigState", func() {
    let physical_level = 0;
    let physical_rig_found = 0;
    let level = 10;

    while (level >= 0) {
        let rig_name = "miner_" + String(level);
        if (InventoryItemExists(rig_name)) {
            physical_level = level;
            physical_rig_found = 1;
            break;
        }
        level -= 1;
    }

    let rig_seen = FileDataRead("gpu_mining_3485717804_rig_seen");
    let max_rig_level = FileDataRead("gpu_mining_3485717804_max_rig_level");

    if (physical_rig_found == 1 and rig_seen != 1) {
        FileDataWrite("gpu_mining_3485717804_rig_seen", 1);
    }
    if (physical_rig_found == 1 and physical_level > max_rig_level) {
        -- As in the published upgrade check, return the superseded tier to
        -- its normal sprite so it cannot keep a stale BTC-ready sprite.
        ItemSetSpriteInventory("miner_" + String(max_rig_level), "rig " + String(max_rig_level));
        ItemSetSpriteIngame("miner_" + String(max_rig_level), "rig " + String(max_rig_level));
        max_rig_level = physical_level;
        FileDataWrite("gpu_mining_3485717804_max_rig_level", max_rig_level);
    }

    return max_rig_level;
});

-- Find the temporary NPC used by the published NPC-to-chest workaround.
ScriptExpose("GpuMining3485717804FindNpcInstance", func(npc_name) {
    let hub_npcs = ObjectGetAllInstances(obj_npc_human_parent);
    while (ArrayLength(hub_npcs) > 0) {
        let current_npc = ArrayFirst(hub_npcs);
        if (current_npc.npc_name == npc_name) {
            return current_npc;
        }
        ArrayDelete(hub_npcs, 0, 1);
    }
});

-- Canonical state is initialized and normalized from enter_hub (new game,
-- save load, raid return) and, as a fallback, by the worker. This is
-- idempotent and does not depend on when init.script runs relative to a save.

-- Dedicated mining worker. The documented player_spawn event creates one for
-- each room/player lifecycle; duplicate and lifetime behavior still requires
-- Windows runtime verification.
ObjectCreate("gpu_mining_3485717804_worker");
ObjectSetType("gpu_mining_3485717804_worker", "obj_mod_generic");
ObjectSetScript("gpu_mining_3485717804_worker", "step_normal_event", func(_inst) {
    if (FileDataRead("gpu_mining_3485717804_state_version") == undefined) {
        let initialize_state = ScriptGet("GpuMining3485717804InitializeState");
        initialize_state();
    }
    let sync_rig_state = ScriptGet("GpuMining3485717804SyncRigState");
    let active_mining_level = sync_rig_state();
    if (active_mining_level > 0) {
        let progress_steps = FileDataRead("gpu_mining_3485717804_progress_steps");
        progress_steps = Clamp(progress_steps + 1, 0, 162000);
        FileDataWrite("gpu_mining_3485717804_progress_steps", progress_steps);
    }
});

EventAssignFunction("player_spawn", func() {
    ObjectSpawn("gpu_mining_3485717804_worker", 0, 0);
});

-- Preserve the published Hub settlement and pending-clearing behavior until a
-- reliable chest collection acknowledgement can be verified at runtime.
EventAssignFunction("enter_hub", func() {
    let initialize_state = ScriptGet("GpuMining3485717804InitializeState");
    let sync_rig_state = ScriptGet("GpuMining3485717804SyncRigState");
    let find_npc_instance = ScriptGet("GpuMining3485717804FindNpcInstance");

    initialize_state();
    ItemSetPriceValue("btc", FileDataRead("gpu_mining_3485717804_btc_price"));

    let active_mining_level = sync_rig_state();
    let progress_steps = FileDataRead("gpu_mining_3485717804_progress_steps");

    if (progress_steps >= 162000) {
        FileDataWrite("gpu_mining_3485717804_pending_btc", active_mining_level);
        FileDataWrite("gpu_mining_3485717804_progress_steps", 0);

        let new_btc_price = Round(RandomRange(100000, 400000));
        FileDataWrite("gpu_mining_3485717804_btc_price", new_btc_price);
        ItemSetPriceValue("btc", new_btc_price);
    }
    if (progress_steps < 162000) {
        FileDataWrite("gpu_mining_3485717804_pending_btc", 0);
    }

    if (FileDataRead("gpu_mining_3485717804_rig_seen") == 1) {
        if (find_npc_instance("GPU Mining Rig") == undefined) {
            NpcSpawn("bitcoin_npc", 320, 900);
        }
        ObjectSpawn("btc_obj", 320, 900);
    }
});

-- Published NPC-to-chest workaround
NpcCopy("bitcoin_npc", "trader_faction1");
NpcSetName("bitcoin_npc", "GPU Mining Rig");
NpcSetChestDropped("bitcoin_npc", "bitcoin_chest");

ObjectCreate("btc_obj");
ObjectSetScript("btc_obj", "create_event", func(_inst) {
    _inst.x = 320;
    _inst.y = 900;
    _inst.depth = -910;
    _inst.completed = false;
    _inst.kill_delay = 0;
    _inst.btc_inst = undefined;

    let find_npc_instance = ScriptGet("GpuMining3485717804FindNpcInstance");
    let npc_inst = find_npc_instance("GPU Mining Rig");
    if (npc_inst != undefined) {
        _inst.btc_inst = npc_inst;
    }
});

ObjectSetScript("btc_obj", "step_normal_event", func(_inst) {
    let pending_btc = FileDataRead("gpu_mining_3485717804_pending_btc");
    let max_rig_level = FileDataRead("gpu_mining_3485717804_max_rig_level");

    if (pending_btc > 0 and max_rig_level > 0) {
        _inst.sprite_index = SpriteGet("rig chest " + String(max_rig_level) + " btc");
        ItemSetSpriteInventory("miner_" + String(max_rig_level), "rig " + String(max_rig_level) + " btc");
        ItemSetSpriteIngame("miner_" + String(max_rig_level), "rig " + String(max_rig_level) + " btc");
    } else {
        _inst.sprite_index = SpriteGet("rig chest " + String(max_rig_level));
        ItemSetSpriteInventory("miner_" + String(max_rig_level), "rig " + String(max_rig_level));
        ItemSetSpriteIngame("miner_" + String(max_rig_level), "rig " + String(max_rig_level));
    }

    if (_inst.completed) {
        return;
    }
    -- Retry the lookup if the NPC was not yet visible when this object was
    -- created, instead of leaving the reward handoff permanently stalled.
    if (_inst.btc_inst == undefined) {
        let find_npc_instance = ScriptGet("GpuMining3485717804FindNpcInstance");
        let npc_inst = find_npc_instance("GPU Mining Rig");
        if (npc_inst != undefined) {
            _inst.btc_inst = npc_inst;
        }
    }
    if (_inst.kill_delay > 1) {
        if (_inst.btc_inst != undefined) {
            ChestSetItemCount("bitcoin_chest", pending_btc, pending_btc);
            _inst.btc_inst.hp = 0;
            _inst.completed = true;
        }
    }
    _inst.kill_delay += 1;
});
