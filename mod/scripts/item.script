TraderAddItem( "bar", "gpu", 1, 0)

-- GPU recipe
CraftingRecipeCreate(CraftingType_Extras,Base_Module_None,0,[
    ["wires",40],
    ["power_outlet",20],
    ["usb", 16],
    ["cpu",16],
    ["power_bank",8],
    ["ram",8],
    ["military_circuit",8],
    ["ssd",8],
    ["gameboy",10],
    ["gamestation",10]
],["gpu",1]);
CraftingRecipeCreate(CraftingType_Extras,Base_Module_None,0,[
