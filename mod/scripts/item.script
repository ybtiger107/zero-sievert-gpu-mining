--GPU base
ItemBarterCreate("gpu");
ItemSetName("gpu", "Graphics Card");
ItemSetDescription("gpu" , "This GPU is the most powerful GPU ever made, bringing game-changing capabilities to gamers and creators. Tackle the most advanced models and most challenging creative workloads with unprecedented AI horsepower." );
ItemSetWeight("gpu" , 2 );
ItemSetPriceValue("gpu", 2000000);
ItemSetStackLimit("gpu", 1);

--gpu sprite
SpriteLoad("gpu sprite","sprite/5090GPU.png",1,0,0,0);
ItemSetSpriteInventory("gpu","gpu sprite");
ItemSetSpriteIngame("gpu","gpu sprite");


--Bitcoin base
ItemBarterCreate("btc");
ItemSetName("btc", "Bitcoin");
ItemSetDescription("btc" , "A digital currency whose price updates at the time of mining and stays constant until the next cycle. Store it in a USB wallet to secure a stable exchange value." );
ItemSetWeight("btc" , 0 );
ItemSetPriceValue("btc", 100000);
ItemSetStackLimit("btc", 1);

--btc sprite
SpriteLoad("btc sprite","sprite/btc.png",1,0,0,0);
ItemSetSpriteInventory("btc","btc sprite");
ItemSetSpriteIngame("btc","btc sprite");

--Bitcoin usb base
ItemBarterCreate("btc_usb");
ItemSetName("btc_usb", "Bitcoin USB");
ItemSetDescription("btc_usb" , "A secure USB device that stores 1 BTC at a fixed value. Once stored, the bitcoin's price will no longer fluctuate. Stability is ensured by the Bunker network.");
ItemSetWeight("btc_usb" , 0.10 );
ItemSetPriceValue("btc_usb", 250000);
ItemSetStackLimit("btc_usb", 100);

--btc sprite
SpriteLoad("btc usb sprite","sprite/btc_usb.png",1,0,0,0);
ItemSetSpriteInventory("btc_usb","btc usb sprite");
ItemSetSpriteIngame("btc_usb","btc usb sprite");

