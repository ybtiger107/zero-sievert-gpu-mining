----------------------------------------------------
--Bitcoin Mining Rig 0 base
ItemBarterCreate("miner_0");
ItemSetName("miner_0", "GPU Mining Rig");
ItemSetDescription("miner_0" , "A custom-built GPU mining rig used to extract cryptocurrency over time." );
ItemSetWeight("miner_0", 30 );
ItemSetPriceValue("miner_0", 0);
ItemSetStackLimit("miner_0", 1);
--Bitcoin Mining Computer_0
SpriteLoad("rig 0","sprite/rig_0.png",1,0,0,0);
ItemSetSpriteInventory("miner_0","rig 0");
ItemSetSpriteIngame("miner_0","rig 0");
ChestAddSpecialItem("electronic_box","miner_0",2);
----------------------------------------------------
--Bitcoin Mining Rig 1 base
ItemBarterCreate("miner_1");
ItemSetName("miner_1", "GPU Mining Rig");
ItemSetDescription("miner_1" , "A custom-built GPU mining rig used to extract cryptocurrency over time. 1 GPU is inserted to Mining Rig" );
ItemSetWeight("miner_1" , 32 );
ItemSetPriceValue("miner_1", 2000000);
ItemSetStackLimit("miner_1", 1);
--Bitcoin Mining Computer_1
SpriteLoad("rig 1","sprite/rig_1.png",1,0,0,0);
SpriteLoad("rig 1 btc","sprite/rig_1_btc.png",1,0,0,0);
ItemSetSpriteInventory("miner_1","rig 1");
ItemSetSpriteIngame("miner_1","rig 1");
--Bitcoin Mining Rig 1 Recipe
CraftingRecipeCreate(CraftingType_BaseUpgrade1, Base_Module_None, 0,[
        ["miner_0",1],
        ["gpu",1]
    ],
    ["miner_1",1]
);
